# Copier ce fichier en .env et remplir avec tes vraies valeurs.
# Le fichier .env est ignoré par git et NE DOIT JAMAIS être committé.

# === Base de données MySQL ===
# Méthode 1 : variables séparées (dev local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stylisme

# Méthode 2 : URL complète (recommandé en prod, fournie par Railway/Aiven/etc.)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Active SSL pour la connexion DB (obligatoire chez la plupart des hébergeurs)
DB_SSL=false

# === Serveur Express ===
PORT=5000

# === Sécurité ===
# Mot de passe pour acceder a /admin (frontend)
# Au moins 16 caractères aléatoires en production
ADMIN_PASSWORD=change_me_in_production

# Origines autorisées pour CORS (séparées par des virgules)
# En prod, mettre l'URL Vercel : https://stylisme.vercel.app
# Vide ou absent = autorise tout (dev uniquement)
CORS_ORIGINS=
