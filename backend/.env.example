# Copier ce fichier en .env et remplir avec tes vraies valeurs.
# Le fichier .env est ignoré par git et NE DOIT JAMAIS être committé.

# Base de donnees MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=stylisme

# Serveur Express
PORT=5000

# Mot de passe pour acceder a /admin (frontend)
# Choisir un mot de passe fort en production (au moins 16 caracteres aleatoires)
ADMIN_PASSWORD=change_me_in_production
